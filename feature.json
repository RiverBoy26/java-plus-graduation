    {
      "name": "16. DELETE /users/{userId}/comments/{commentId} - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 404\", function () {\r",
              "    pm.response.to.have.status(404);\r",
              "});\r",
              "pm.test(\"Сообщение об ошибке содержит 'Comment not found'\", function () {\r",
              "    pm.expect(pm.response.json().message).to.include(\"Comment not found\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
