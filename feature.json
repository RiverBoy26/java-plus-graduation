    {
      "name": "17. GET /admin/comments/users/{userId} - успешно",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Тело ответа - массив\", function () {\r",
              "    pm.expect(pm.response.json()).to.be.an('array');\r",
              "});\r",
              "pm.test(\"Комментарии содержат обязательные поля\", function () {\r",
              "    const comments = pm.response.json();\r",
              "    if (comments.length > 0) {\r",
              "        const comment = comments[0];\r",
              "        pm.expect(comment).to.have.property('id');\r",
              "        pm.expect(comment).to.have.property('text');\r",
              "        pm.expect(comment).to.have.property('author');\r",
              "        pm.expect(comment).to.have.property('event');\r",
              "        pm.expect(comment).to.have.property('created');\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
